---
import Navbar from "../components/Navbar.astro";
import MainLayouts from "../layouts/MainLayout.astro";

// Server Only
const name = "Astro";
const title = 'Home Page';
---
<MainLayouts title="Home Page">

		<h1>{name}</h1>
		<p>Momento actual: {new Date().toLocaleString()}</p>
		<p id="current-time">Momento actual: </p>




		<script>
import { callSafely } from "astro:actions";

			// Client Only
			const currentYear: number = new Date().getFullYear();
			const currentTimeParagraph = document.querySelector('#current-time') as HTMLParagraphElement;

		
			currentTimeParagraph.innerText = `Momento actual real: ${new Date().toLocaleString()}`;

			
		</script>
</MainLayouts>

