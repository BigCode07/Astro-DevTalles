---
// Codigo Server Side Only - Momento de construccion Build Time

import type { GetStaticPaths } from "astro";
import type { PokemonListResponse } from "../../../interfaces/pokemon-list.response";
import MainLayout from "../../../layouts/MainLayout.astro";
import PokemonCard from "../../../components/pokemons/PokemonCard.astro";
import "../../../styles/global.css";

export const getStaticPaths = (async () => {
  const POKEMONS_PER_PAGE = 12;

  // Obtener el total de pokemones disponibles
  const resp = await fetch("https://pokeapi.co/api/v2/pokemon?limit=1");
  const data = (await resp.json()) as PokemonListResponse;
  const totalPokemons = data.count;

  // Calcular el número total de páginas
  const totalPages = Math.ceil(totalPokemons / POKEMONS_PER_PAGE);

  // Generar las rutas para cada página
  const paths = [];

  for (let i = 1; i <= totalPages; i++) {
    const offset = (i - 1) * POKEMONS_PER_PAGE;
    const response = await fetch(
      `https://pokeapi.co/api/v2/pokemon?limit=${POKEMONS_PER_PAGE}&offset=${offset}`
    );
    const pageData = (await response.json()) as PokemonListResponse;

    paths.push({
      params: { page: i.toString() },
      props: {
        pokemons: pageData.results,
        currentPage: i,
        totalPages: totalPages
      }
    });
  }

  return paths;
}) satisfies GetStaticPaths;

const { pokemons, currentPage, totalPages } = Astro.props;
const title = `Pokémon - Página ${currentPage} de ${totalPages}`;
---

<MainLayout title={title}>
  <div class="min-h-screen w-full py-6 sm:py-10 px-3 sm:px-4 relative overflow-hidden" style="background: linear-gradient(135deg, #9bbc0f 0%, #8bac0f 50%, #306230 100%);">
    <!-- Patrón de fondo tipo Game Boy -->
    <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px), repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px);"></div>

    <!-- Patrón de puntos -->
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, #000 2px, transparent 2px); background-size: 20px 20px;"></div>

    <div class="max-w-7xl mx-auto relative z-10">
      <!-- Título estilo Game Boy Screen -->
      <div class="text-center mb-8 sm:mb-12">
        <!-- Pantalla tipo Game Boy -->
        <div class="inline-block bg-gradient-to-br from-gray-800 via-gray-900 to-black px-6 sm:px-12 py-6 sm:py-10 border-8 border-black rounded-3xl relative" style="box-shadow: 0 16px 32px rgba(0,0,0,0.6), inset 0 4px 8px rgba(255,255,255,0.1);">
          <!-- Pantalla interior -->
          <div class="bg-gradient-to-br from-amber-100 to-amber-200 px-4 sm:px-8 py-4 sm:py-6 border-4 border-gray-700 rounded-xl relative overflow-hidden" style="box-shadow: inset 0 4px 12px rgba(0,0,0,0.3), 0 2px 4px rgba(255,255,255,0.2);">
            <!-- Efecto de escaneo CRT -->
            <div class="absolute inset-0 opacity-30 pointer-events-none" style="background: repeating-linear-gradient(0deg, transparent 0px, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px);"></div>

            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-center retro-text relative z-10" style="color: #0f380f; text-shadow: 2px 2px 0px rgba(155, 188, 15, 0.3);">
              POKEMON
            </h1>
            <p class="text-xs sm:text-sm md:text-base font-bold text-center mt-2 retro-text" style="color: #306230;">
              ALBUM COLLECTION
            </p>
          </div>

          <!-- LED indicador -->
          <div class="absolute -right-2 top-1/2 transform -translate-y-1/2 w-4 h-4 bg-red-500 rounded-full border-2 border-black animate-pulse" style="box-shadow: 0 0 12px rgba(239, 68, 68, 0.8), inset 0 1px 2px rgba(255,255,255,0.5);"></div>

          <!-- Tornillos decorativos -->
          <div class="absolute top-2 left-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
          <div class="absolute top-2 right-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
          <div class="absolute bottom-2 left-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
          <div class="absolute bottom-2 right-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
        </div>

        <!-- Badge de página -->
        <div class="mt-4 sm:mt-6">
          <div class="inline-block bg-gradient-to-r from-red-600 via-red-500 to-red-600 px-4 sm:px-8 py-2 sm:py-3 border-4 border-black rounded-xl relative" style="box-shadow: 0 6px 0px #000, 0 8px 12px rgba(0,0,0,0.4);">
            <p class="text-xs sm:text-base font-bold text-white retro-text">
              PAGE {currentPage}/{totalPages}
            </p>
            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-20 rounded-xl"></div>
          </div>
        </div>
      </div>

      <!-- Grid de Pokémon -->
      <section
        aria-label="Listado de Pokemones"
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-6 gap-4 md:gap-6 mb-8"
      >
        {
          pokemons.map((pokemon) => (
            <PokemonCard name={pokemon.name} url={pokemon.url} page={currentPage} />
          ))
        }
      </section>

      <!-- Paginación estilo D-Pad -->
      <nav class="mt-8 sm:mt-12 flex flex-wrap justify-center items-center gap-2 sm:gap-4 mb-8" aria-label="Paginación">
        <!-- Botón anterior -->
        {currentPage > 1 ? (
          <a
            href={currentPage === 2 ? "/" : `/pokemons/page/${currentPage - 1}`}
            class="bg-gradient-to-b from-blue-400 to-blue-600 hover:from-blue-500 hover:to-blue-700 px-4 sm:px-6 py-3 sm:py-4 border-4 border-black rounded-lg transform hover:scale-105 active:scale-95 transition-all duration-150 text-xs sm:text-sm font-bold text-white retro-text relative"
            style="box-shadow: 0 4px 0px #000, 0 6px 12px rgba(0,0,0,0.4);"
          >
            <span class="relative z-10">◄ PREV</span>
            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-10 rounded-lg"></div>
          </a>
        ) : (
          <div class="bg-gray-500 px-4 sm:px-6 py-3 sm:py-4 border-4 border-gray-700 rounded-lg opacity-50 text-xs sm:text-sm font-bold text-white retro-text cursor-not-allowed" style="box-shadow: 0 4px 0px #374151, 0 6px 8px rgba(0,0,0,0.3);">
            ◄ PREV
          </div>
        )}

        <!-- Página actual -->
        <div class="bg-gradient-to-b from-yellow-400 to-yellow-600 px-6 sm:px-8 py-3 sm:py-4 border-4 border-black rounded-lg text-xs sm:text-base font-bold text-black retro-text relative" style="box-shadow: 0 4px 0px #000, 0 6px 12px rgba(0,0,0,0.4);">
          <span class="relative z-10">{currentPage} / {totalPages}</span>
          <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-10 rounded-lg"></div>
        </div>

        <!-- Botón siguiente -->
        {currentPage < totalPages ? (
          <a
            href={`/pokemons/page/${currentPage + 1}`}
            class="bg-gradient-to-b from-green-400 to-green-600 hover:from-green-500 hover:to-green-700 px-4 sm:px-6 py-3 sm:py-4 border-4 border-black rounded-lg transform hover:scale-105 active:scale-95 transition-all duration-150 text-xs sm:text-sm font-bold text-white retro-text relative"
            style="box-shadow: 0 4px 0px #000, 0 6px 12px rgba(0,0,0,0.4);"
          >
            <span class="relative z-10">NEXT ►</span>
            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-10 rounded-lg"></div>
          </a>
        ) : (
          <div class="bg-gray-500 px-4 sm:px-6 py-3 sm:py-4 border-4 border-gray-700 rounded-lg opacity-50 text-xs sm:text-sm font-bold text-white retro-text cursor-not-allowed" style="box-shadow: 0 4px 0px #374151, 0 6px 8px rgba(0,0,0,0.3);">
            NEXT ►
          </div>
        )}
      </nav>
    </div>
  </div>
</MainLayout>
