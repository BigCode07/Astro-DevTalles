---
// Codigo Server Side Only - Momento de construccion Build Time

import type { GetStaticPaths } from "astro";
import type { PokemonListResponse } from "../../../interfaces/pokemon-list.response";
import MainLayout from "../../../layouts/MainLayout.astro";
import PokemonCard from "../../../components/pokemons/PokemonCard.astro";
import "../../../styles/global.css";

export const getStaticPaths = (async () => {
  const POKEMONS_PER_PAGE = 10;

  // Obtener el total de pokemones disponibles
  const resp = await fetch("https://pokeapi.co/api/v2/pokemon?limit=1");
  const data = (await resp.json()) as PokemonListResponse;
  const totalPokemons = data.count;

  // Calcular el número total de páginas
  const totalPages = Math.ceil(totalPokemons / POKEMONS_PER_PAGE);

  // Generar las rutas para cada página
  const paths = [];

  for (let i = 1; i <= totalPages; i++) {
    const offset = (i - 1) * POKEMONS_PER_PAGE;
    const response = await fetch(
      `https://pokeapi.co/api/v2/pokemon?limit=${POKEMONS_PER_PAGE}&offset=${offset}`
    );
    const pageData = (await response.json()) as PokemonListResponse;

    paths.push({
      params: { page: i.toString() },
      props: {
        pokemons: pageData.results,
        currentPage: i,
        totalPages: totalPages
      }
    });
  }

  return paths;
}) satisfies GetStaticPaths;

const { pokemons, currentPage, totalPages } = Astro.props;
const title = `Pokémon - Página ${currentPage} de ${totalPages}`;
---

<MainLayout title={title}>
  <div class="min-h-screen w-full py-6 sm:py-10 px-3 sm:px-4" style="background: linear-gradient(to bottom, #f4e4c1 0%, #e8d4a8 100%); background-image: url('data:image/svg+xml;base64,');">
    <div class="max-w-7xl mx-auto">
      <!-- Título -->
      <div class="text-center mb-8 sm:mb-12">
        <div class="inline-block bg-amber-100 px-4 sm:px-12 py-3 sm:py-6 sm:transform sm:-rotate-1 border-2 sm:border-4 border-amber-800 relative" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.2); background-image: linear-gradient(45deg, #fef3c7 25%, transparent 25%, transparent 75%, #fef3c7 75%, #fef3c7), linear-gradient(45deg, #fef3c7 25%, transparent 25%, transparent 75%, #fef3c7 75%, #fef3c7); background-size: 20px 20px; background-position: 0 0, 10px 10px;">
          <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-1 sm:mb-2 text-center" style="color: #b45309; font-family: 'Courier New', monospace; letter-spacing: 1px; text-shadow: 2px 2px 0px rgba(0,0,0,0.1);">
            MI ÁLBUM POKÉMON
          </h1>
          <div class="hidden sm:block absolute -top-3 -left-3 w-16 h-8 bg-yellow-200 border-2 border-yellow-400 transform rotate-45 opacity-70" style="box-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></div>
          <div class="hidden sm:block absolute -top-3 -right-3 w-16 h-8 bg-yellow-200 border-2 border-yellow-400 transform -rotate-45 opacity-70" style="box-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></div>
          <div class="hidden sm:block absolute -bottom-3 -left-3 w-16 h-8 bg-yellow-200 border-2 border-yellow-400 transform -rotate-45 opacity-70" style="box-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></div>
          <div class="hidden sm:block absolute -bottom-3 -right-3 w-16 h-8 bg-yellow-200 border-2 border-yellow-400 transform rotate-45 opacity-70" style="box-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></div>
        </div>
        <div class="mt-3 sm:mt-4">
          <p class="text-sm sm:text-xl font-bold inline-block px-3 sm:px-6 py-1.5 sm:py-2 bg-red-600 text-white sm:transform sm:rotate-1" style="font-family: 'Courier New', monospace; box-shadow: 2px 2px 0px rgba(0,0,0,0.3);">
            ★ PÁGINA {currentPage} DE {totalPages} ★
          </p>
        </div>
      </div>

      <!-- Grid de Pokémon -->
      <section
        aria-label="Listado de Pokemones"
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-8"
      >
        {
          pokemons.map((pokemon) => (
            <PokemonCard name={pokemon.name} url={pokemon.url} page={currentPage} />
          ))
        }
      </section>

      <!-- Paginación -->
      <nav class="mt-8 sm:mt-12 flex flex-wrap justify-center items-center gap-2 sm:gap-4" aria-label="Paginación">
        {currentPage > 1 && (
          <a
            href={`/pokemons/page/${currentPage - 1}`}
            class="px-3 sm:px-6 py-2 sm:py-3 bg-amber-100 border-2 sm:border-4 border-amber-800 font-bold sm:transform hover:-rotate-1 transition-transform text-xs sm:text-base"
            style="box-shadow: 2px 2px 0px rgba(0,0,0,0.2); font-family: 'Courier New', monospace; color: #b45309;"
          >
            ← ANTERIOR
          </a>
        )}

        <span class="px-3 sm:px-6 py-2 sm:py-3 bg-red-600 text-white font-bold border-2 sm:border-4 border-red-800 text-xs sm:text-base" style="box-shadow: 2px 2px 0px rgba(0,0,0,0.2); font-family: 'Courier New', monospace;">
          {currentPage} / {totalPages}
        </span>

        {currentPage < totalPages && (
          <a
            href={`/pokemons/page/${currentPage + 1}`}
            class="px-3 sm:px-6 py-2 sm:py-3 bg-amber-100 border-2 sm:border-4 border-amber-800 font-bold sm:transform hover:rotate-1 transition-transform text-xs sm:text-base"
            style="box-shadow: 2px 2px 0px rgba(0,0,0,0.2); font-family: 'Courier New', monospace; color: #b45309;"
          >
            SIGUIENTE →
          </a>
        )}
      </nav>
    </div>
  </div>
</MainLayout>
