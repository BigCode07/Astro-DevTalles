---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import PokemonCard from "../../components/pokemons/PokemonCard.astro";

export const getStaticPaths = (async () => {
  const resp = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
  const data = await resp.json();
  return await Promise.all(
    data.results.map(async (pokemon: { name: string; url: string }) => {
      const response = await fetch(`https://pokeapi.co/api/v2/pokemon/${pokemon.name}`);
      const pokemonData = await response.json();
      return {
        params: { name: pokemon.name },
        props: { url: pokemon.url || `https://pokeapi.co/api/v2/pokemon/${pokemonData.id}/` }
      };
    })
  );
}) satisfies GetStaticPaths;

const { name } = Astro.params;
const { url } = Astro.props;

const id = url.split("/").at(-2);
const audioSrc = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`;    
---

<MainLayout title={`Pokemon - ${name}`}``}>
  <div class="min-h-screen w-full py-6 sm:py-10 px-3 sm:px-4 relative overflow-hidden" style="background: linear-gradient(135deg, #9bbc0f 0%, #8bac0f 50%, #306230 100%);">
    <!-- Patrón de fondo tipo Game Boy -->
    <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px), repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px);"></div>

    <!-- Patrón de puntos -->
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, #000 2px, transparent 2px); background-size: 20px 20px;"></div>

    <div class="container mx-auto relative z-10" style="max-width: 600px;">

      <!-- Título estilo Game Boy Screen -->
      <div class="text-center mb-4 md:mb-6">
        <div class="inline-block bg-gradient-to-br from-gray-800 via-gray-900 to-black px-8 sm:px-16 py-6 sm:py-10 border-8 border-black rounded-3xl relative" style="box-shadow: 0 16px 32px rgba(0,0,0,0.6), inset 0 4px 8px rgba(255,255,255,0.1);">
          <!-- Pantalla interior -->
          <div class="bg-gradient-to-br from-amber-100 to-amber-200 px-6 sm:px-12 py-4 sm:py-6 border-4 border-gray-700 rounded-xl relative overflow-hidden" style="box-shadow: inset 0 4px 12px rgba(0,0,0,0.3), 0 2px 4px rgba(255,255,255,0.2);">
            <!-- Efecto de escaneo CRT -->
            <div class="absolute inset-0 opacity-30 pointer-events-none" style="background: repeating-linear-gradient(0deg, transparent 0px, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px);"></div>

            <h1 class="text-2xl sm:text-3xl md:text-5xl font-black text-center capitalize retro-text relative z-10 whitespace-nowrap" style="color: #0f380f; text-shadow: 2px 2px 0px rgba(155, 188, 15, 0.3);">
              {name}
            </h1>
          </div>

          <!-- LED indicador -->
          <div class="absolute -right-2 top-1/2 transform -translate-y-1/2 w-4 h-4 bg-red-500 rounded-full border-2 border-black animate-pulse" style="box-shadow: 0 0 12px rgba(239, 68, 68, 0.8), inset 0 1px 2px rgba(255,255,255,0.5);"></div>

          <!-- Tornillos decorativos -->
          <div class="absolute top-2 left-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
          <div class="absolute top-2 right-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
          <div class="absolute bottom-2 left-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
          <div class="absolute bottom-2 right-2 w-3 h-3 bg-gray-600 rounded-full border border-gray-800" style="box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);"></div>
        </div>
      </div>

      <!-- Tarjeta del Pokémon -->
      <div class="text-center mb-6 md:mb-8">
        <div class="inline-block w-full max-w-md bg-gradient-to-br from-gray-700 via-gray-800 to-gray-900 rounded-2xl border-6 md:border-8 border-black p-3 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] md:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all duration-300">
          <div class="bg-gradient-to-br from-amber-50 via-white to-amber-100 rounded-xl p-6 md:p-8 border-4 border-gray-600" style="box-shadow: inset 0 2px 8px rgba(0,0,0,0.1);">
            <PokemonCard name={name} url={url} isBig />

            <!-- Reproductor de audio personalizado -->
            <div class="mt-6 bg-gradient-to-br from-red-600 via-red-500 to-red-600 rounded-xl border-4 border-black p-5 shadow-lg relative" style="box-shadow: 0 6px 0px #000, 0 8px 16px rgba(0,0,0,0.4);">
              <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-20 rounded-xl pointer-events-none"></div>

              <p class="text-white text-sm font-bold text-center mb-3 retro-text relative z-10" style="text-shadow: 2px 2px 0px rgba(0,0,0,0.5);">GRITO POKÉMON</p>

              <div class="flex items-center gap-3 relative z-10">
                <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-yellow-300 to-yellow-500 rounded-full border-4 border-black flex items-center justify-center shadow-md relative">
                  <span class="text-2xl">🔊</span>
                  <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-10 rounded-full"></div>
                </div>
                <div class="flex-1 bg-gray-900 bg-opacity-30 rounded-lg p-2 border-2 border-black">
                  <audio controls class="w-full h-10" style="filter: sepia(0.1) saturate(1.1) contrast(1.05);">
                    <source src={audioSrc} type="audio/ogg" />
                    Tu navegador no soporta el elemento de audio.
                  </audio>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Botón de navegación estilo D-Pad -->
      <div class="text-center">
        <button
          onclick="window.location.href = sessionStorage.getItem('pokemonListPage') ? `/pokemons/page/${sessionStorage.getItem('pokemonListPage')}` : '/'"
          class="bg-gradient-to-b from-green-400 to-green-600 hover:from-green-500 hover:to-green-700 px-6 sm:px-8 py-3 sm:py-4 border-4 border-black rounded-lg transform hover:scale-105 active:scale-95 transition-all duration-150 text-sm sm:text-base font-bold text-white retro-text relative cursor-pointer inline-block"
          style="box-shadow: 0 4px 0px #000, 0 6px 12px rgba(0,0,0,0.4);"
        >
          <span class="relative z-10">◄ VOLVER</span>
          <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-10 rounded-lg"></div>
        </button>
      </div>

    </div>
  </div>
</MainLayout>
