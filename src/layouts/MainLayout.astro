---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { siteInfo } from '../consts/site-info';
import NavBar from '../components/shared/NavBar.astro';

interface Props {
    title: string;
	image?: string;
	description?: string; 
}

const {title = siteInfo.title, description = siteInfo.description, image} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

        <!-- SEO -->
		<meta name="description" content={description} />
		{image && <meta name="image" content={image} />}
		<meta property="author" content="BigCode" />

		<!-- OG Metatags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={image} />}

		<!-- Required -->
		<title>{title}</title>

		<!-- Google Fonts - Press Start 2P para un look más retro -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

		<ClientRouter />

		<style is:global>
			:root {
				--gb-screen: #9bbc0f;
				--gb-dark: #0f380f;
				--gb-mid: #306230;
				--gb-light: #8bac0f;
				--pixel-border: 4px;
			}

			@view-transition {
				navigation: auto;
			}

			/* Animaciones tipo Game Boy */
			::view-transition-old(root),
			::view-transition-new(root) {
				animation-duration: 0.3s;
				animation-timing-function: steps(4);
			}

			::view-transition-old(root) {
				animation-name: pixelate-out;
			}

			::view-transition-new(root) {
				animation-name: pixelate-in;
			}

			@keyframes pixelate-out {
				to {
					opacity: 0;
					filter: brightness(2);
				}
			}

			@keyframes pixelate-in {
				from {
					opacity: 0;
					filter: brightness(2);
				}
			}

			/* Animación especial para las tarjetas - Efecto Game Boy */
			::view-transition-old(pokemon-card),
			::view-transition-new(pokemon-card) {
				animation-duration: 0.4s;
				animation-timing-function: steps(8);
			}

			::view-transition-old(pokemon-card) {
				animation-name: card-dissolve;
			}

			::view-transition-new(pokemon-card) {
				animation-name: card-appear;
			}

			@keyframes card-dissolve {
				to {
					opacity: 0;
					transform: scale(0.8);
					filter: brightness(3);
				}
			}

			@keyframes card-appear {
				from {
					opacity: 0;
					transform: scale(1.2);
					filter: brightness(0);
				}
			}

			/* Estilos retro para las tarjetas de Pokémon */
			.pokemon-card {
				position: relative;
				transition: all 0.2s ease;
				image-rendering: pixelated;
				image-rendering: -moz-crisp-edges;
				image-rendering: crisp-edges;
			}

			.pokemon-card:hover {
				transform: translateY(-8px) scale(1.05);
				filter: brightness(1.1) contrast(1.1);
			}

			.pokemon-card:active {
				transform: translateY(-4px) scale(1.02);
			}

			/* Efecto de escaneo CRT */
			.pokemon-card::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: repeating-linear-gradient(
					0deg,
					rgba(0, 0, 0, 0.03) 0px,
					rgba(0, 0, 0, 0.03) 1px,
					transparent 1px,
					transparent 2px
				);
				pointer-events: none;
				border-radius: 12px;
				opacity: 0.5;
			}

			/* Animación de brillo tipo holográfico de cartas */
			.pokemon-card::before {
				content: '';
				position: absolute;
				top: -50%;
				left: -50%;
				width: 200%;
				height: 200%;
				background: linear-gradient(
					45deg,
					transparent 30%,
					rgba(255, 255, 255, 0.1) 50%,
					transparent 70%
				);
				opacity: 0;
				transition: opacity 0.3s ease;
				pointer-events: none;
				border-radius: 12px;
				transform: rotate(45deg);
			}

			.pokemon-card:hover::before {
				opacity: 1;
				animation: holographic 2s linear infinite;
			}

			@keyframes holographic {
				0% {
					transform: translateX(-100%) rotate(45deg);
				}
				100% {
					transform: translateX(100%) rotate(45deg);
				}
			}

			/* Efecto pixelado en imágenes */
			.pokemon-image-retro {
				image-rendering: pixelated;
				image-rendering: -moz-crisp-edges;
				image-rendering: crisp-edges;
				transition: all 0.2s ease;
			}

			.pokemon-card:hover .pokemon-image-retro {
				transform: scale(1.15);
				filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.5));
			}

			/* Animación flotante para tarjetas grandes */
			.pokemon-big-card {
				animation: float-retro 3s ease-in-out infinite;
			}

			@keyframes float-retro {
				0%, 100% {
					transform: translateY(0px);
				}
				50% {
					transform: translateY(-10px);
				}
			}

			/* Efecto de pulsación en badges */
			.pokemon-badge {
				animation: pulse-badge 2s ease-in-out infinite;
			}

			@keyframes pulse-badge {
				0%, 100% {
					transform: scale(1);
				}
				50% {
					transform: scale(1.05);
				}
			}

			/* Tipografía pixelada */
			.retro-text {
				font-family: 'Press Start 2P', 'Courier New', monospace;
				text-shadow:
					2px 2px 0px rgba(0, 0, 0, 0.3),
					4px 4px 0px rgba(0, 0, 0, 0.1);
				letter-spacing: 1px;
			}

			/* Bordes pixelados */
			.pixel-border {
				border-style: solid;
				border-image:
					repeating-linear-gradient(90deg, #000 0, #000 4px, transparent 4px, transparent 8px) 4;
			}

			/* Sombras optimizadas estilo retro */
			.pokemon-card:hover {
				box-shadow:
					8px 8px 0px rgba(0, 0, 0, 0.3),
					12px 12px 0px rgba(0, 0, 0, 0.15),
					0 0 30px rgba(255, 255, 255, 0.2);
			}

			/* Efecto de resplandor tipo Game Boy */
			.gb-glow {
				box-shadow:
					inset 0 0 20px rgba(155, 188, 15, 0.1),
					0 0 10px rgba(155, 188, 15, 0.3);
			}
		</style>
	</head>
	<body class="m-0 p-0">
		<NavBar />
		<main>
			<slot />
		</main>
	</body>
</html>