---
interface Props {
  name: string;
  url: string;
}

const { name, url } = Astro.props;
---

<button
  class="favorite-button absolute top-2 left-2 z-30 w-10 h-10 bg-white bg-opacity-90 backdrop-blur-sm rounded-full border-3 border-black flex items-center justify-center cursor-pointer hover:bg-opacity-100 hover:scale-110 active:scale-95 transition-all duration-200 shadow-lg group"
  data-name={name}
  data-url={url}
  aria-label={`Toggle favorite for ${name}`}
  style="box-shadow: 0 3px 8px rgba(0,0,0,0.4);"
>
  <!-- Corazón vacío (cuando NO es favorito) -->
  <svg
    class="heart-empty w-6 h-6"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
      class="text-red-600"
    />
  </svg>

  <!-- Corazón lleno (cuando ES favorito) -->
  <svg
    class="heart-filled w-6 h-6 hidden"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <path
      d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"
      class="text-red-600"
    />
  </svg>
</button>

<script>
  import { FavoritesManager } from '../../utils/favorites';

  // Función para actualizar el estado visual del botón
  function updateButtonState(button: HTMLButtonElement) {
    const name = button.dataset.name;
    if (!name) return;

    const isFavorite = FavoritesManager.isFavorite(name);
    const heartEmpty = button.querySelector('.heart-empty');
    const heartFilled = button.querySelector('.heart-filled');

    if (isFavorite) {
      heartEmpty?.classList.add('hidden');
      heartFilled?.classList.remove('hidden');
    } else {
      heartEmpty?.classList.remove('hidden');
      heartFilled?.classList.add('hidden');
    }
  }

  // Inicializar todos los botones de favoritos
  function initializeFavoriteButtons() {
    const buttons = document.querySelectorAll('.favorite-button');

    buttons.forEach((button) => {
      const btn = button as HTMLButtonElement;

      // Establecer estado inicial
      updateButtonState(btn);

      // Manejar click
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const name = btn.dataset.name;
        const url = btn.dataset.url;

        if (name && url) {
          const isFavorite = FavoritesManager.toggleFavorite({ name, url });

          // Actualizar el botón inmediatamente
          updateButtonState(btn);

          // Animación de feedback
          btn.style.transform = 'scale(1.3)';
          setTimeout(() => {
            btn.style.transform = '';
          }, 200);
        }
      });
    });
  }

  // Inicializar cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', initializeFavoriteButtons);

  // Re-inicializar después de las transiciones de Astro
  document.addEventListener('astro:page-load', initializeFavoriteButtons);

  // Escuchar cambios en favoritos para actualizar todos los botones
  window.addEventListener('favoritesChanged', () => {
    const buttons = document.querySelectorAll('.favorite-button');
    buttons.forEach((button) => {
      updateButtonState(button as HTMLButtonElement);
    });
  });
</script>
